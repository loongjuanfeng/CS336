watch_file .env
dotenv_if_exists .env

environment="${CS336_ENVIRONMENT:-local}"
case "$environment" in
    local|default)
        ;;
    *)
        log_error "CS336_ENVIRONMENT must be 'local' or 'default'"
        exit 1
        ;;
esac

export CS336_ENVIRONMENT="$environment"
export UV_PROJECT_ENVIRONMENT="$PWD/.venvs/$environment"
export VIRTUAL_ENV="$UV_PROJECT_ENVIRONMENT"
PATH_add "$VIRTUAL_ENV/bin"

if [[ "$environment" == "default" ]]; then
    export UV_NO_SOURCES=1
else
    unset UV_NO_SOURCES
fi
